# ============================================================================
# Multi-Agent Orchestration System - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# Postgres (used by the `db` service AND injected into the FastAPI/Celery
# containers as DATABASE_URL below)
# ---------------------------------------------------------------------------
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_pass
POSTGRES_DB=agent_db

# Full async SQLAlchemy connection string used by the backend + worker.
# Host "db" matches the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://agent_user:agent_pass@db:5432/agent_db

# ---------------------------------------------------------------------------
# Redis (Celery broker + result backend, and WebSocket pub/sub bus)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# LLM Provider - choose "openai", "anthropic", or "groq"
# ---------------------------------------------------------------------------
# Groq: free-tier friendly, very fast inference on open models (Llama etc).
# Get a key at https://console.groq.com/keys
# Good default model: llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# --- Alternative providers (swap LLM_PROVIDER above to use one of these) ---
# openai:    LLM_PROVIDER=openai    LLM_API_KEY=sk-...      LLM_MODEL=gpt-4o-mini
# anthropic: LLM_PROVIDER=anthropic LLM_API_KEY=sk-ant-...   LLM_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# Tool provider API keys
# ---------------------------------------------------------------------------
# https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-key-here
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your-brave-search-key-here

# ---------------------------------------------------------------------------
# CORS - comma-separated list of origins allowed to call the API
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Misc backend tuning
# ---------------------------------------------------------------------------
TOOL_RESULT_TIMEOUT_SECONDS=30
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Frontend (Vite) - the browser-facing API/WS base URLs
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
